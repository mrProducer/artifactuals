# Supabase (from your project's API settings: https://supabase.com/dashboard)
# Copy this file to .env.local and fill in real values. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only (used by API routes / jobs; NOT exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of the app (used for OG tags and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Artifact sandbox origin (production: artifacts.artifactuals.com).
# Leave both empty in local dev — sandbox routes are served from the app
# origin and isolation relies on the iframe sandbox attribute.
# SANDBOX_HOST=artifacts.artifactuals.com
# NEXT_PUBLIC_SANDBOX_URL=https://artifacts.artifactuals.com

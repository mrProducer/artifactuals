# Supabase (from Project Settings -> API: https://supabase.com/dashboard)
# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# The app reads BOTH the new (publishable/secret) and legacy (anon/service_role)
# key names, preferring the new ones. Set whichever pair your dashboard shows.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Client key — safe to expose. New name preferred; legacy still works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # legacy alternative

# Server-only secret — bypasses RLS. NEVER exposed to the browser.
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...       # legacy alternative

# Base URL of the app (used for OG tags and share links). MUST be the real
# public URL in production so OG image URLs are absolute (LinkedIn requires it).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Preview/OG screenshots are rendered at publish time via ScreenshotOne
# (https://screenshotone.com). Set the access key in production so the share
# image is ready before the link is shared. Left unset (e.g. local dev), the
# render is skipped and the OG route serves a branded fallback card.
SCREENSHOTONE_ACCESS_KEY=
# Optional: public origin a headless browser should hit to render the sandbox.
# Defaults to NEXT_PUBLIC_SITE_URL; only set if the renderer should use a
# different reachable host (must be publicly accessible, not localhost).
# SCREENSHOT_APP_URL=https://artifactuals.com

# Artifact sandbox origin (production: artifacts.artifactuals.com).
# Leave both empty in local dev — sandbox routes are served from the app
# origin and isolation relies on the iframe sandbox attribute.
# SANDBOX_HOST=artifacts.artifactuals.com
# NEXT_PUBLIC_SANDBOX_URL=https://artifacts.artifactuals.com
